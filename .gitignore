# ==========================================
# Caché y archivos compilados de Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Entornos Virtuales y Variables de Entorno
# ==========================================
venv/
env/
.env

# ==========================================
# Archivos Temporales y de Datos (Excel)
# ==========================================
# Ignora los archivos temporales que crea Excel cuando lo tienes abierto (los que empiezan con ~$)
~$*.xlsx

# (Opcional) Descomenta la siguiente línea si NO quieres subir tus archivos Excel al repositorio:
# data/*.xlsx
*.xlsx

# ==========================================
# Credenciales de Google Sheets (cuenta de servicio)
# ==========================================
credentials.json
*-credentials.json

# ==========================================
# Configuración de Editores de Código (IDE)
# ==========================================
.vscode/
.idea/

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Node / Frontend
# ==========================================
node_modules/
dist/
build/

# ==========================================
# Logs y cachés varios
# ==========================================
*.log
.pytest_cache/
.coverage
.ipynb_checkpoints/

# ==========================================
# Herramientas de agentes/IA (Claude Code, etc.)
# ==========================================
.agents/
.claude/
CLAUDE.md
graphify-out/
skills-lock.json
.graphifyignore