# Copia este archivo como .env y rellena los valores.
#
# ID del Google Sheet (de la URL: https://docs.google.com/spreadsheets/d/<ESTO>/edit)
VITE_GOOGLE_SHEET_ID=

# URL del Google Apps Script publicado como aplicación web (termina en /exec).
# Ver apps-script/Code.gs para publicarlo.
VITE_APPS_SCRIPT_URL=
